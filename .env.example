# ===========================================
# n8n-self-hosted-lab - environment configuration
# Copy to .env and adjust the values
# ===========================================

# Time zone
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# Host and port
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Webhook URL (required when using a reverse proxy or domain)
# N8N_WEBHOOK_URL=https://n8n.example.com/
# N8N_EDITOR_BASE_URL=https://n8n.example.com/

# Sensitive data encryption (recommended for production)
# Generate: openssl rand -hex 32
# N8N_ENCRYPTION_KEY=

# ----- Only for compose.postgres.yml -----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=n8n
