# ===========================================
# n8n – konfiguracja środowiska (PoC)
# Skopiuj do .env i dostosuj wartości
# ===========================================

# Strefa czasowa
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# Host i port
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Webhook URL (wymagane gdy n8n stoi za reverse proxy / domeną)
# N8N_WEBHOOK_URL=https://n8n.twoja-domena.pl/
# N8N_EDITOR_BASE_URL=https://n8n.twoja-domena.pl/

# Szyfrowanie danych wrażliwych (zalecane w produkcji)
# Wygeneruj: openssl rand -hex 32
# N8N_ENCRYPTION_KEY=

# ----- Tylko dla compose.postgres.yml -----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=zmien_mnie_na_silne_haslo
POSTGRES_DB=n8n
